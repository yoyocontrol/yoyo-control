    },
    "Text and links go onto the computer’s clipboard. Photos and files are saved to its Downloads folder and copied there too." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text and links go onto the computer’s clipboard. Photos and files are saved to its Downloads folder and copied there too."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文本和链接会放到电脑的剪贴板上；照片和文件会保存到电脑的「下载」文件夹，并同时复制到剪贴板。"
          }
        }
      }
    },
    "Text and links go onto the Mac’s clipboard. Photos and files are saved to its Downloads folder and copied there too." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text and links go onto the Mac’s clipboard. Photos and files are saved to its Downloads folder and copied there too."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文本和链接会放到 Mac 的剪贴板上；照片和文件会保存到 Mac 的「下载」文件夹，并同时复制到剪贴板。"
          }
        }
      }
    },
