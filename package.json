{
  "name": "@yoyocontrol/account-server",
  "version": "0.2.0",
  "description": "An account server: OpenID Connect sign-in, an account's computers and devices, tickets into each computer, a signed revocation list",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "bin": {
    "yoyo-account-server": "./dist/main.js",
    "yoyo-account-admin": "./dist/admin-cli.js",
    "yoyo-account-dev": "./dist/dev.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "@yoyocontrol/account": "git+https://github.com/yoyocontrol/yoyo-control.git#account-v0.2.0",
    "jose": "^6.0.0"
  },
  "gitHead": "876cc742d89ce760600dd9d702f4b38a078dc8de"
}
