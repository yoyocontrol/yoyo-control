{
  "name": "@yoyocontrol/screen-ui",
  "version": "0.1.3",
  "description": "The Screen page and the Clipboard page of a Yoyo Control computer as framework-free Web Components (<yoyo-screen>, <yoyo-clipboard>), on @yoyocontrol/screen-web",
  "keywords": [
    "yoyo-control",
    "remote-desktop",
    "web-components",
    "custom-elements"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoyocontrol/yoyo-control.git",
    "directory": "packages/screen-ui"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./dist/index.js"
  ],
  "dependencies": {
    "@yoyocontrol/screen-web": "^0.3.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --import tsx \"test/*.test.ts\"",
    "demo": "npm run build && npm -w packages/screen-web --prefix ../.. run build && node demo/serve.mjs",
    "e2e": "node test/e2e/run.mjs",
    "e2e:control": "npm run build && (cd ../screen-web && npm run build) && node test/e2e/control.mjs"
  },
  "devDependencies": {
    "@yoyocontrol/link-web": "*",
    "esbuild": "^0.28.2"
  }
}
